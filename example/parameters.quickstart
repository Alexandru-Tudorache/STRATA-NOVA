# n20 without csm; one elapsed day on 400 zones
# install the authorised n20 profile/composition pair before running

outdir = "quickstart_out"
profile_name = "profiles/ddt_cases/wdprofile_ddt_2013_n20.dat"
comp_profile_name = "profiles/ddt_cases/wdcomp_ddt_2013_n20.dat"
csm = "none"
mass_scheme = "non_constant_mass_loss"
csm_outer_radius_cm = 1.0d16
csm_mass_msun = 3.0d-4
csm_mdot_msun_per_yr = 5.0d-6
csm_wind_velocity_kms = 2.0d2
csm_temperature_k = 1.0d3
csm_extension_zones = 320
csm_blend_zones = 50
csm_composition_preset = "solar"
csm_surface_mix_zones = 30
simulation_mode = "single"
staged_workdir = "csm"
staged_n_shells = 1
staged_final_day = 16.0d0
staged_equal_arrival_time = 1
staged_observer_nmu = 32
staged_shell_inner_radii_cm = 6.0d14
staged_shell_masses_msun = 5.0d-6
staged_shell_widths_cm = 1.5d14
initial_data = "Piston_Explosion"
piston_vel = 3.9d9
piston_tstart = 0.0d0
piston_tend = 1.0d-2
final_energy = 1.0d51
bomb_tstart = 0.0d0
bomb_tend = 0.01d0
bomb_mass_spread = 0.2d0
bomb_start_point = 1
imax = 400
grid_mode = "legacy_native"
grid_update_interval_days = 0.1d0
mass_excision = 0
mass_excised = 0.01d0
radiation = 1
eoskey = 2
Ni_switch = 1
initial_model_age_s = 0.0d0
Ni_mass = 0.5
Ni_mix_fraction = 0.50d0
Ni_mix_component2_fraction = 0.30d0
Ni_mix_component2_extent = 0.50d0
Ni_mix_kernel = 1
Ni_by_hand = 0
Ni_period = 1.0d4
Ni_period_max = 5.456d5
Ni_fractional_change = 0.01d0
Ni_quad_npoints = 20
saha_ncomps = 1
smooth_ni_luminosity = 1
boxcar_smoothing = 0
boxcar_smooth_ni = 1
boxcar_nominal_mass_msun = 0.200d0
boxcar_number_iterations = 4
boxcar_ni_nominal_mass_msun = 0.150d0
boxcar_ni_number_iterations = 4
opacity_floor_envelope = 0.0001d0
opacity_floor_core = 0.0001d0
ntmax = 10000000000000
dtout_scalar = 1.0d2
tend = 8.64d4
dtout = 1.0d2
dtout_mid = 1.0d3
dtout_fast = 1.0d3
dtout_scalar_mid = 5.0d3
dtout_scalar_fast = 5.0d3
output_mid_transition_days = 1.0d0
output_late_transition_days = 2.0d1
dtout_check = 1.7d9
ntout = -1
ntout_scalar = -1
ntout_check = -1
ntinfo = -1
dtmin = 1.0d-10
dtmax = 1.0d2
evolution_temperature_floor_k = 1.00d2
epstol_hydro = 1.0d-4
epstol_rad = 1.0d-4
itmax_hydro = 300
itmax_rad = 300
ni_raytrace_opt = 1
ni_ray_interp = 1
output_mode = 2
sedov = 0
